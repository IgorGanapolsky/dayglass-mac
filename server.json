{
  "ok": true,
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.igorganapolsky/dayglass",
  "title": "Dayglass \u2014 macOS Screen & Meeting Memory + OpenUI MCP Server",
  "version": "2.4.0",
  "description": "Bot-free macOS call recorder with Apple Vision OCR of your screen, and a local MCP server that Claude Code, Claude Desktop and Cursor can read while a call is happening.",
  "homepage": "https://igorganapolsky.github.io/dayglass-mac/",
  "repository": {
    "url": "https://github.com/IgorGanapolsky/dayglass-mac",
    "source": "github"
  },
  "supported_ai_fleet": [
    "cursor",
    "claude_desktop",
    "claude_code",
    "gemini_antigravity",
    "chatgpt_codex",
    "grok",
    "muse_spark",
    "omp"
  ],
  "install": {
    "homebrew_cask": "brew install --cask igorganapolsky/dayglass/dayglass",
    "curl_installer": "curl -fsSL https://igorganapolsky.github.io/dayglass-mac/install.sh | bash",
    "dmg_url": "https://github.com/IgorGanapolsky/dayglass-mac/releases/latest/download/Dayglass.dmg",
    "mcp_command": "python3 -m dayglass mcp",
    "omnibus_cli": "python3 -m dayglass omnibus --install-connectors",
    "openapi_spec": "http://127.0.0.1:3333/api/connector/openapi.json"
  },
  "target_directories": [
    {
      "name": "PulseMCP",
      "submit_url": "https://www.pulsemcp.com/submit"
    },
    {
      "name": "Smithery",
      "submit_url": "https://smithery.ai/new"
    },
    {
      "name": "Glama",
      "submit_url": "https://glama.ai/mcp/servers"
    },
    {
      "name": "MCPMarket",
      "submit_url": "https://mcpmarket.com/submit"
    }
  ]
}
